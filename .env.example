# XiaoAi-LLM-Router 环境变量模板（与 config.yaml 双通道，env 优先）
# 用法: cp .env.example .env ；docker compose 会自动读取 .env

# --- 小米账号（MiService 同款，设备绑定用） ---
MI_USERNAME=your_mi_account
MI_PASSWORD=your_mi_password

# --- MiService 网关地址（容器外/内按部署改） ---
MISEERVICE_URL=http://localhost:8080
MISEERVICE_MQTT_HOST=127.0.0.1
MISEERVICE_MQTT_PORT=1883

# --- 大模型密钥（只填你要用的 provider，其余留空） ---
DEEPSEEK_API_KEY=sk-xxxx_xxxx_xxxx
OPENAI_API_KEY=
# 容器内访问宿主机 Ollama（默认 host.docker.internal:11434）
OLLAMA_BASE_URL=http://host.docker.internal:11434
